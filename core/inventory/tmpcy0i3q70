from __future__ import annotations
from typing import List, Dict

def build_pm_kit_for_equipment(equipment_code: str, beta: float, parts: List[Dict]) -> List[Dict]:
    """
    Règle simple :
      - beta < 1  : vieillissement infantile -> focus 'connexion', 'contact', 'vibration'
      - 1 <= beta < 2 : aléatoire -> 'isolation', 'huile', 'joint'
      - beta >= 2 : vieillissement/usage -> 'huile', 'joint', 'ventilation', 'isolateur'
    On propose 6 pièces si possible, et une 'quantite_recommandee'=min(2, max(1, seuil - dispo)) à titre indicatif.
    """
    if not parts:
        return []
    beta = float(beta or 1.5)
    keysets = []
    if beta < 1.0:
        keysets = ["contact", "connexion", "vibration", "cable"]
    elif beta < 2.0:
        keysets = ["isolation", "huile", "joint", "capteur"]
    else:
        keysets = ["huile", "joint", "ventilation", "isolateur", "filtre"]

    sel = []
    for kw in keysets:
        for p in parts:
            name = f"{p.get('nom','')} {p.get('famille','')}".lower()
            if kw in name:
                d = dict(p)
                dispo = int(d.get("quantite_dispo", d.get("quantite", 0)) or 0)
                seuil = int(d.get("seuil_min", 0) or 0)
                reco = max(1, min(2, max(0, seuil - dispo)))
                d["quantite_recommandee"] = reco
                sel.append(d)
                if len(sel) >= 6:
                    break
        if len(sel) >= 6:
            break
    return sel
